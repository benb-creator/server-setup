# Settings for all services. Every service folder links to this file as ".env".
# setup.sh / Ansible fill in DOMAIN etc. and replace each CHANGEME with a random secret.

# --- Your organization ---
DOMAIN=example.com                  # mail domain: addresses and chat IDs are user@DOMAIN
ORG_NAME="Example Org"              # shown on the login page
ADMIN_EMAIL=it@example.com          # contact for Let's Encrypt
PUBLIC_IP=203.0.113.10              # public IPv4 address of this server
PUBLIC_IP6=""                       # public IPv6 address (optional)
ADMIN_NETWORKS="0.0.0.0/0 ::/0"     # who may open the Keycloak admin console; narrow this to your admin network

# --- Host names ---
AUTH_HOST=auth.${DOMAIN}
MAIL_HOST=mail.${DOMAIN}
CHAT_HOST=chat.${DOMAIN}
MEET_HOST=meet.${DOMAIN}
FILES_HOST=files.${DOMAIN}
REALM=office                        # Keycloak realm
ISSUER=https://${AUTH_HOST}/realms/${REALM}

# --- Mail ---
DKIM_SELECTOR=office1
MAIL_RELAY_HOST=""                  # split domain: the other mail system for users not on Stalwart, e.g. exchange.example.com
MAIL_GROUP=""                       # only members of this Keycloak group get a mailbox here (empty = all users)

# --- Provisioning ---
SYNC_INTERVAL=300                   # seconds between full syncs from Keycloak to the apps
SYNC_DELETE=false                   # true: delete app accounts of users deleted in Keycloak; false: only disable them

# --- DNS (see dns/dns.sh) ---
DNS_MAIL_RECORDS=no                 # yes: also push MX, SPF and DMARC to the DNS provider (only for a new mail domain)

# --- Active Directory (optional, see auth/ad.sh) ---
AD_URL=""                           # e.g. ldaps://dc1.ad.example.com
AD_BIND_DN=""                       # e.g. CN=svc-keycloak,OU=Service,DC=ad,DC=example,DC=com
AD_BIND_PASSWORD=""
AD_USERS_DN=""                      # e.g. OU=Staff,DC=ad,DC=example,DC=com
AD_KERBEROS_REALM=""                # e.g. AD.EXAMPLE.COM, for Windows SSO (needs auth/kerberos/keycloak.keytab)

# --- Secrets (keep this file safe, back it up) ---
POSTGRES_PASSWORD=CHANGEME
KEYCLOAK_ADMIN_PASSWORD=CHANGEME
KEYCLOAK_DB_PASSWORD=CHANGEME
STALWART_ADMIN_PASSWORD=CHANGEME
STALWART_DB_PASSWORD=CHANGEME
EJABBERD_DB_PASSWORD=CHANGEME
NEXTCLOUD_ADMIN_PASSWORD=CHANGEME
NEXTCLOUD_DB_PASSWORD=CHANGEME
NEXTCLOUD_OIDC_SECRET=CHANGEME
LIVEKIT_API_SECRET=CHANGEME
SYNC_CLIENT_SECRET=CHANGEME
